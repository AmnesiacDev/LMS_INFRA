@Library('leroy-jenkins-library') _


pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }
    triggers {
        pollSCM('H/5 * * * *')
    }
    environment {
        BACKEND_JOB_NAME   = 'lms-backend-pipeline'
        FRONTEND_JOB_NAME  = 'lms-frontend-pipeline'
        NGINX_JOB_NAME = 'lms-nginx-pipeline'
        IMAGE_TAG = "${env.BUILD_NUMBER}"
        INFRA_DIR        = '/git-repos/LMS_Infra'
        INFRA_REPO_URL   = 'https://github.com/AmnesiacDev/LMS_INFRA.git'
        WORKDIR          = '/home/jenkins/agent/workspace/algogambit'
        TEST_DIR         = '/git-repos/LMS_Test'
        FRONTEND_REPO_DIR         = '/git-repos/LMS_FrontEnd'
        FRONTEND_REPO_URL         = 'https://github.com/AmnesiacDev/LMS_FrontEnd.git'
        BACKEND_REPO_DIR         = '/git-repos/LMS'
        BACKEND_REPO_URL         = 'https://github.com/AmnesiacDev/LMS.git'
    }

       

    stages {

        stage('Checkout Infra') {
            agent { docker {
                image 'git-agent:latest'
                args '-v /git-repos:/git-repos'
                }
            }
            steps {
                dir("${INFRA_DIR}") {
                    git branch: 'main', url: "${INFRA_REPO_URL}"
                }
            }
        }
        stage('Checkout Backend') {
            agent { docker {
                image 'git-agent:latest'
                args '-v git-repos:/git-repos'
                }
            }
            steps {
                checkForUpdate(BACKEND_REPO_DIR, TEST_DIR, BACKEND_REPO_URL)
            }
        }

        stage('Trigger backend pipeline') {
            steps {
                script {
                    def result = triggerPipeline(
                        env.BACKEND_JOB_NAME,
                        env.IMAGE_TAG
                    )
                    echo "${result.result}"
                }
            }
        }

        stage('Checkout Frontend') {
            agent { docker {
                image 'git-agent:latest'
                args '-v /git-repos:/git-repos'
                }
            }
            steps {
                checkForUpdates(FRONTEND_REPO_DIR, TEST_DIR, FRONTEND_REPO_URL)
            }
        }

        stage('Trigger frontend pipeline') {
            steps {
                script {
                    def result = triggerPipeline(
                        env.FRONTEND_JOB_NAME,
                        env.IMAGE_TAG
                    )
                    echo "${result.result}"
                }
            }
        }

        stage('Trigger nginx pipeline') {
            steps {
                script {
                    def result = triggerPipeline(
                        env.NGINX_JOB_NAME,
                        env.IMAGE_TAG
                    )
                    echo "${result.result}"
                }
            }
        }

    }

    post {
        success {
            script {
                sh "echo 'success beep boop'"
            }
        }
        unstable {
            echo 'One or more downstream deploys failed - check the linked job logs. Last-good SHA was NOT advanced, so it will retry next cycle.'
        }
    }
}
