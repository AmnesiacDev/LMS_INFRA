@Library('leroy-jenkins-library') _


pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }
    triggers {
        pollSCM('H/5 * * * *')
    }
    environment {
        BACKEND_JOB_NAME   = 'lms-backend-pipeline'
        FRONTEND_JOB_NAME  = 'lms-frontend-pipeline'
        NGINX_JOB_NAME = 'lms-nginx-pipeline'
        IMAGE_TAG = "${env.BUILD_NUMBER}"
        INFRA_DIR        = 'LMS_Infra'
        INFRA_REPO_URL   = 'https://github.com/AmnesiacDev/LMS_INFRA.git'
    }

       

    stages {


        stage('Checkout Infra') {
            agent {label 'node-agent'}
            steps {
                dir("${INFRA_DIR}") {
                    git branch: 'main',
                        url: "${INFRA_REPO_URL}"                
                }
            }
        }
        stage('Trigger backend pipeline') {
            steps {
                script {
                    def result = triggerPipeline(
                        env.BACKEND_JOB_NAME,
                        env.IMAGE_TAG
                    )
                    echo "${result.result}"
                }
            }
        }

        stage('Trigger frontend pipeline') {
            steps {
                script {
                    def result = triggerPipeline(
                        env.FRONTEND_JOB_NAME,
                        env.IMAGE_TAG
                    )
                    echo "${result.result}"
                }
            }
        }

        stage('Trigger nginx pipeline') {
            steps {
                script {
                    def result = triggerPipeline(
                        env.NGINX_JOB_NAME,
                        env.IMAGE_TAG
                    )
                    echo "${result.result}"
                }
            }
        }

        stage('Deploy') {
            agent {label 'node-agent'}
            steps {
                dir("${INFRA_DIR}") {
                    script {
                        composeDeploy()
                    }
                }
            }
        }

    }

    post {
        success {
            script {
                sh "echo 'success beep boop'"
            }
        }
        unstable {
            echo 'One or more downstream deploys failed - check the linked job logs. Last-good SHA was NOT advanced, so it will retry next cycle.'
        }
    }
}
