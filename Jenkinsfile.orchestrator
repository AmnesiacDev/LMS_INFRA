@Library('leroy-jenkins-library') _


pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }
    triggers {
        pollSCM('H/5 * * * *')
    }
    environment {
        BACKEND_JOB_NAME   = 'lms-backend-pipeline'
        FRONTEND_JOB_NAME  = 'lms-frontend-pipeline'
        NGINX_JOB_NAME = 'lms-nginx-pipeline'
        IMAGE_TAG = "${env.BUILD_NUMBER}"
        INFRA_DIR        = '/opt/LMS_Infra'
        INFRA_REPO_URL   = 'https://github.com/AmnesiacDev/LMS_INFRA.git'
        JOB_BASE_NAME    = env.JOB_BASE_NAME
        WORKDIR          = '/home/jenkins/agent/workspace/algogambit'
    }

       

    stages {


            stage('Checkout Infra') {
                agent {label 'node-agent'}
                steps {
                    sh '''
                        if [ -d "/opt/LMS_Infra/.git" ]; then
                            echo "LMS_Infra already exists. Updating..."
            
                            cd /opt/LMS_Infra
            
                            git fetch origin
                            git reset --hard origin/main
                            git clean -fd
            
                        else
                            echo "LMS_Infra does not exist. Cloning..."
            
                            sudo rm -rf /opt/LMS_Infra
            
                            sudo git clone \
                                ${INFRA_REPO_URL} \
                                ${INFRA_DIR}
                        fi
                    '''
            }
        }
        stage('Trigger backend pipeline') {
            steps {
                script {
                    def result = triggerPipeline(
                        env.BACKEND_JOB_NAME,
                        env.IMAGE_TAG
                    )
                    echo "${result.result}"
                }
            }
        }

        stage('Trigger frontend pipeline') {
            steps {
                script {
                    def result = triggerPipeline(
                        env.FRONTEND_JOB_NAME,
                        env.IMAGE_TAG
                    )
                    echo "${result.result}"
                }
            }
        }

        stage('Trigger nginx pipeline') {
            steps {
                script {
                    def result = triggerPipeline(
                        env.NGINX_JOB_NAME,
                        env.IMAGE_TAG
                    )
                    echo "${result.result}"
                }
            }
        }

        stage('Deploy') {
            agent {label 'node-agent'}
            steps {
                dir("${INFRA_DIR}") {
                    script {
                        composeDeploy()
                    }
                }
            }
        }

    }

    post {
        success {
            script {
                sh "echo 'success beep boop'"
            }
        }
        unstable {
            echo 'One or more downstream deploys failed - check the linked job logs. Last-good SHA was NOT advanced, so it will retry next cycle.'
        }
    }
}
